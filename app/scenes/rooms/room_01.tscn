[node name="PaintingShadow" parent="." instance=ExtResource("4_painting")]
position = Vector2(320, 100)
description = "A tall figure stands among a crowd, painted in the same pigments as everyone else — but where every other figure casts a shadow, this one casts none. The crowd does not seem to notice. Or perhaps they cannot."

[node name="PaintingGift" parent="." instance=ExtResource("4_painting")]
position = Vector2(640, 100)
description = "A man kneels, offering his own chest to a blade held by someone whose face has flaked away with age. His expression is not fear. It is gratitude. Beneath the varnish, a faint gold thread rises from him toward the top of the frame."

[node name="PaintingHunt" parent="." instance=ExtResource("4_painting")]
position = Vector2(960, 100)
description = "A hunting scene. Riders with lances surround a beast at bay. The painter gave every rider bright, careful eyes — and left the beast's sockets as bare, unpainted canvas. Whatever it was, it had nothing left inside to paint."
